# AWS credentials: use the standard boto3 chain (env vars, shared credentials
# file, or an IAM role) — do not hardcode keys here or anywhere in this repo.
AWS_REGION=us-east-1

# From novamart-multi-agent-agentcore after `python src/agent_orchestrator.py deploy`
# (or `agentcore status`). Leave blank locally and /api/chat will return a 503
# with a clear message instead of pretending to work.
AGENTCORE_RUNTIME_ARN=

# Comma-separated list of origins allowed to call this proxy.
ALLOWED_ORIGINS=http://localhost:5173
